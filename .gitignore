# Build and Release Folders
bin-debug/
bin-release/
[Oo]bj/
[Bb]in/

# Other files and folders
.settings/

# Executables
*.swf
*.air
*.ipa
*.apk

# Project files, i.e. `.project`, `.actionScriptProperties` and `.flexProperties`
# should NOT be excluded as they contain compiler settings and other important
# information for Eclipse / Flash Builder.

# ==================== 项目配置忽略规则 ====================

# 配置文件（包含敏感信息）
config.py
.env
.env.local
.env.*.local

# 密钥和凭证
*.key
*.pem
*.crt
credentials.json
secrets.json

# API 密钥文件
api_keys.txt
api_key.py

# 向量数据库目录（大文件，不需要版本控制）
chroma_db/
vector_db/

# 模型缓存
models/
.cache/

# 日志文件
*.log
logs/

# 测试数据
text_test/
test_data/

# Streamlit 配置
.streamlit/secrets.toml
.streamlit/config.toml

# Python 缓存
__pycache__/
*.pyc
*.pyo
*.pyd

# 虚拟环境
venv/
env/
.env/
.python-version

# 操作系统文件
.DS_Store
Thumbs.db
desktop.ini
