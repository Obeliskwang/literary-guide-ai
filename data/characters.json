      "family": "高老庄",
      "role": "主要角色"
    },
    {
      "id": "sha_seng",
      "name": "沙僧",
      "identity": "卷帘大将、金身罗汉",
      "description": "原是天庭卷帘大将，因打碎琉璃盏被贬流沙河，后加入取经队伍",
      "family": "流沙河",
      "role": "主要角色"
    },
    {
      "id": "white_dragon",
      "name": "白龙马",
      "identity": "玉龙三太子、八部天龙广力菩萨",
      "description": "西海龙王敖闰之子，因纵火烧毁玉帝赐予的明珠被贬，后化为白马驮唐僧取经",
      "family": "西海龙族",
      "role": "主要角色"
    },
    {
      "id": "buddha",
      "name": "如来佛祖",
      "identity": "西天极乐世界教主",
      "description": "佛教最高领袖，将孙悟空压在五行山下，赐予取经任务",
