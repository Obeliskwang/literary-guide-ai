{
  "book": "西游记",
  "characters": [
    {
      "id": "sun_wukong",
      "name": "孙悟空",
      "identity": "齐天大圣、斗战胜佛",
      "description": "由仙石孕育而生，学得七十二变、筋斗云等神通，大闹天宫后被如来佛祖压在五行山下，后随唐僧西天取经",
      "family": "花果山",
      "role": "主要角色"
    },
    {
      "id": "tang_seng",
      "name": "唐僧",
      "identity": "大唐高僧、旃檀功德佛",
      "description": "唐太宗李世民的御弟，西天取经的领导者，慈悲为怀但有时迂腐",
      "family": "大唐",
      "role": "主要角色"
    },
    {
      "id": "zhu_bajie",
      "name": "猪八戒",
      "identity": "天蓬元帅、净坛使者",
